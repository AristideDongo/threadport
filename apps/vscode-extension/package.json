{
  "name": "threadport-vscode",
  "displayName": "ThreadPort",
  "description": "Keep one continuous development session across AI coding agents.",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "publisher": "Aristideghost",
  "repository": {
    "type": "git",
    "url": "https://github.com/AristideDongo/threadport.git"
  },
  "homepage": "https://github.com/AristideDongo/threadport#readme",
  "bugs": {
    "url": "https://github.com/AristideDongo/threadport/issues"
  },
  "icon": "media/threadport.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "extensionKind": ["workspace"],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["AI", "agents", "Claude", "Codex", "developer tools", "context"],
  "main": "./dist/extension.js",
  "activationEvents": ["onFileSystem:threadport"],
  "files": ["dist/extension.js", "media/", "README.md", "CHANGELOG.md", "SUPPORT.md", "LICENSE"],
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies --out dist/threadport-vscode.vsix",
    "publish:marketplace": "vsce publish --packagePath dist/threadport-vscode.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "contributes": {
    "commands": [
      { "command": "threadport.initializeProject", "title": "Initialize Project", "category": "ThreadPort", "icon": "$(database)" },
      { "command": "threadport.newSession", "title": "New Session", "category": "ThreadPort", "icon": "$(add)" },
      { "command": "threadport.openSessionPage", "title": "View Session", "category": "ThreadPort" },
      { "command": "threadport.openSession", "title": "Open Session", "category": "ThreadPort" },
      { "command": "threadport.document.runInstruction", "title": "Run Instruction", "category": "ThreadPort", "icon": "$(play)" },
      { "command": "threadport.document.stopAgent", "title": "Stop Agent", "category": "ThreadPort", "icon": "$(debug-stop)" },
      { "command": "threadport.document.resume", "title": "Resume Interrupted Work", "category": "ThreadPort", "icon": "$(debug-rerun)" },
      { "command": "threadport.document.previewContext", "title": "Preview Context", "category": "ThreadPort", "icon": "$(preview)" },
      { "command": "threadport.document.verify", "title": "Verify Work", "category": "ThreadPort", "icon": "$(beaker)" },
      { "command": "threadport.document.reviewChanges", "title": "Review Changes", "category": "ThreadPort", "icon": "$(diff)" },
      { "command": "threadport.addActiveFile", "title": "Add File to Context", "category": "ThreadPort", "icon": "$(pinned)" },
      { "command": "threadport.addSelectionToContext", "title": "Add Selection to Context", "category": "ThreadPort" },
      { "command": "threadport.refresh", "title": "Refresh", "category": "ThreadPort", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "threadport", "title": "ThreadPort", "icon": "media/threadport.svg" }
      ]
    },
    "views": {
      "threadport": [
        { "id": "threadport.sessions", "name": "Sessions", "icon": "media/threadport.svg" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threadport.sessions",
        "contents": "Create a persistent development session that can move between AI agents.\n[New Session](command:threadport.newSession)"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "threadport.newSession", "when": "view == threadport.sessions", "group": "navigation@1" },
        { "command": "threadport.refresh", "when": "view == threadport.sessions", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "threadport.openSession", "when": "view == threadport.sessions && viewItem == threadport.session", "group": "inline@1" },
        { "command": "threadport.initializeProject", "when": "view == threadport.sessions && viewItem == threadport.uninitialized", "group": "inline@1" }
      ],
      "explorer/context": [
        { "command": "threadport.addActiveFile", "when": "resourceScheme == file", "group": "threadport@1" }
      ],
      "editor/context": [
        { "command": "threadport.addActiveFile", "when": "resourceScheme == file", "group": "threadport@1" },
        { "command": "threadport.addSelectionToContext", "when": "resourceScheme == file && editorHasSelection", "group": "threadport@2" }
      ]
    },
    "keybindings": [
      {
        "command": "threadport.document.runInstruction",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "resourceScheme == threadport && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "ThreadPort",
      "properties": {
        "threadport.context.mode": {
          "type": "string",
          "enum": ["minimal", "standard", "deep", "full"],
          "default": "standard",
          "description": "Context detail level used for agent handoffs."
        }
      }
    }
  }
}
