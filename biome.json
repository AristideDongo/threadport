{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**",
			"test/**",
			"scripts/**",
			"apps/vscode-extension/src/**",
			"apps/vscode-extension/esbuild.mjs"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["src/**", "apps/**", "scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noFocusedTests": "off"
					}
				}
			}
		}
	]
}
