{
  "name": "threadport",
  "version": "0.5.0",
  "description": "CLI for carrying development context across AI coding agents",
  "license": "MIT",
  "homepage": "https://threadport-io.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AristideDongo/threadport.git"
  },
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "codex",
    "claude",
    "context",
    "sessions",
    "mcp"
  ],
  "type": "module",
  "workspaces": [
    "apps/vscode-extension"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "bin": {
    "threadport": "dist/interfaces/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/interfaces/cli/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:agents:live": "tsx scripts/agent-smoke.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "tsc -p tsconfig.json --noEmit && biome check && node scripts/check-boundaries.mjs",
    "check:extension": "npm run check --workspace threadport-vscode",
    "build:extension": "npm run build && npm run build --workspace threadport-vscode",
    "package:extension": "npm run build:extension && npm run package --workspace threadport-vscode"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "js-tiktoken": "^1.0.21",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
