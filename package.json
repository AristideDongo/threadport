{
  "name": "threadport",
  "version": "0.3.2",
  "description": "CLI for carrying development context across AI coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AristideDongo/threadport.git"
  },
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "codex",
    "claude",
    "context",
    "sessions",
    "mcp"
  ],
  "type": "module",
  "files": [
    "dist/"
  ],
  "bin": {
    "threadport": "dist/interfaces/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/interfaces/cli/main.ts",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "js-tiktoken": "^1.0.21",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
